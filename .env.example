# Copy to .env before running, or run scripts/setup.sh to generate it.
# Do not commit a real .env file.

# PostgreSQL
POSTGRES_DB=manga_db
POSTGRES_USER=manga
POSTGRES_PASSWORD=change-me
# Docker Compose expands this from the POSTGRES_* values above.
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Backend
STORAGE_ROOT=/app/backend/storage
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081

# Translation / local LLM gateway (optional, OpenAI-compatible)
# Docker Desktop Model Runner from inside the backend container:
#   http://model-runner.docker.internal/engines/v1
# Other host providers usually look like: http://host.docker.internal:<port>/v1
# Replace local-model/local-embedding-model with provider model IDs before using translation.
TRANSLATION_PROVIDER_MODE=compatible_local
TRANSLATION_BASE_URL=http://model-runner.docker.internal/engines/v1
TRANSLATION_MODEL=local-model
TRANSLATION_API_KEY=
TRANSLATION_MEMORY_EMBEDDING_BASE_URL=http://model-runner.docker.internal/engines/v1
TRANSLATION_MEMORY_EMBEDDING_MODEL=local-embedding-model
TRANSLATION_MEMORY_EMBEDDING_API_KEY=
LLM_INFERENCE_BASE_URL=http://model-runner.docker.internal/engines/v1
LLM_INFERENCE_API_KEY=not-needed-for-local

# Host inference worker for YOLO segmentation. OCR assets are loaded by the backend.
INFERENCE_MODE=remote
INFERENCE_REMOTE_URL=http://host.docker.internal:8001
